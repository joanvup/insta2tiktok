# ==============================================================================
# INSTAGRAM
# ==============================================================================
# Nombre de usuario de la cuenta pública de Instagram a monitorear
INSTAGRAM_USERNAME=nombre_usuario_publico

# Cantidad de Reels más recientes a obtener por ejecución (1-50)
INSTAGRAM_REELS_COUNT=5

# (Opcional) Ruta a archivo de sesión de instaloader para evitar rate-limiting
# Generar con: instaloader --login TU_USUARIO
# Dejar vacío si no se quiere iniciar sesión (solo funciona en cuentas públicas)
INSTAGRAM_SESSION_FILE=

# Delay mínimo y máximo en segundos entre peticiones a Instagram.
# Subir estos valores reduce el riesgo de bloqueo por rate-limiting.
INSTAGRAM_REQUEST_DELAY_MIN=1.0
INSTAGRAM_REQUEST_DELAY_MAX=3.0

# ==============================================================================
# TIKTOK — credenciales en https://developers.tiktok.com/manage/apps
# ==============================================================================
# Client Key de tu app en TikTok for Developers
TIKTOK_CLIENT_KEY=tu_client_key_aqui

# Client Secret de tu app en TikTok for Developers
TIKTOK_CLIENT_SECRET=tu_client_secret_aqui

# Redirect URI EXACTO registrado en tu app. TikTok EXIGE https://.
# Para desarrollo local usa ngrok:  ngrok http 8080  ->  https://xxxx.ngrok-free.app
# En producción usa un dominio propio con TLS, ej: https://miapp.example.com/tiktok/cb
TIKTOK_REDIRECT_URI=https://tu-dominio.example.com/callback

# Host y puerto donde la app ESCUCHA el callback OAuth localmente.
# Esto es distinto del redirect URI: si usas ngrok, ngrok escucha en 8080
# y reenvía a tu 127.0.0.1:8080.
TIKTOK_CALLBACK_HOST=127.0.0.1
TIKTOK_CALLBACK_PORT=8080

# Scopes solicitados. Para Direct Post (publicar en tu perfil) solo hace
# falta video.publish. video.upload pertenece a la API legacy.
TIKTOK_SCOPES=video.publish

# Nivel de privacidad de los posts.
# SELF_ONLY             = privado (lo UNICO que funciona sin auditoría de TikTok)
# MUTUAL_FOLLOW_FRIENDS = requiere auditoría
# FOLLOWER_OF_CREATOR   = requiere auditoría
# PUBLIC_TO_EVERYONE    = requiere auditoría
# El código ajusta automáticamente a SELF_ONLY si la API lo rechaza.
TIKTOK_PRIVACY=SELF_ONLY

# Duración máxima en segundos usada para validar cuando no se puede
# consultar creator_info. La API admite hasta 600s (10 min).
TIKTOK_MAX_VIDEO_DURATION_SEC=600

# Ruta al binario ffprobe. Se usa para validar duración/resolución/FPS/codec
# ANTES de subir, evitando gastar cuota con videos que TikTok rechazará.
# Windows: "ffprobe" si está en PATH, o ruta absoluta ej. C:/ffmpeg/bin/ffprobe.exe
FFPROBE_PATH=ffprobe

# Prefijo opcional para el caption en TikTok (ej: "[Repost]")
TIKTOK_CAPTION_PREFIX=

# Sufijo opcional para el caption en TikTok (ej: "Sígueme en IG @usuario")
TIKTOK_CAPTION_SUFFIX=

# Hashtags adicionales a añadir al caption de TikTok
TIKTOK_CAPTION_HASHTAGS=

# ==============================================================================
# GENERAL
# ==============================================================================
# Ruta a la base de datos SQLite
DB_PATH=reels.db

# Directorio donde se guardan los videos descargados temporalmente
WORKDIR=workdir

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Archivo de log (con rotación automática)
LOG_FILE=insta2tiktok.log

# Máximo de publicaciones por día (protección anti-spam).
# Ojo: TikTok también aplica su propio límite y puede devolver
# spam_risk_too_many_posts o reached_active_user_cap.
MAX_DAILY_PUBLISHES=5

# Máximo de publicaciones por ejecución
PUBLISH_LIMIT_PER_RUN=2

# Reintentos máximos antes de abandonar un Reel fallido
MAX_RETRY_COUNT=3

# Intervalo en minutos para el modo programado (APScheduler)
SCHEDULE_INTERVAL_MINUTES=60

# Horas de retención de videos publicados antes de borrarlos del disco
VIDEO_RETENTION_HOURS=48

# ==============================================================================
# OPCIONALES
# ==============================================================================
# Activar deduplicación por hash perceptual.
# Requiere: pip install imagehash Pillow av
ENABLE_PERCEPTUAL_HASH=false